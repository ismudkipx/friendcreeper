{
  "schemaVersion": 1,
  "id": "friendcreeper",
  "version": "${version}",
  "name": "Friend Creeper",
  "description": "Tame Creepers with gunpowder and make them your friend.",
  "authors": ["smalldayDC_"],
  "contact": {
    "homepage": "https://modrinth.com/mod/friendcreeper",
    "sources": "https://github.com/ismudkipx/friendcreeper",
    "issues": "https://github.com/ismudkipx/friendcreeper/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.smalldaydc.friendcreeper.FriendCreeperMod"],
    "client": ["com.smalldaydc.friendcreeper.client.FriendCreeperClient"],
    "modmenu": ["com.smalldaydc.friendcreeper.client.FriendCreeperModMenuEntry"],
    "jade": [
      "com.smalldaydc.friendcreeper.compat.jade.FriendCreeperJadePlugin"
