      "config": "friendcreeper.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": ">=0.145.1",
    "minecraft": "~26.1",
    "java": ">=25"
